{
  "appId": "com.vexsiz.cbctviewer",
  "appName": "CBCT Viewer",
  "webDir": "www",
  "loggingBehavior": "production",
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "ios": {
    "contentInset": "always",
    "limitsNavigationsToAppBoundDomains": true
  },
  "server": {
    "androidScheme": "https",
    "iosScheme": "capacitor"
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": false
    }
  }
}
